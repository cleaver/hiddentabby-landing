---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Support — HiddenTabby"
  description="HiddenTabby is open-source software, supported by volunteers and free for everyone to use."
>
  <main class="document-page container" id="main">
    <a class="back-link" href="/#top">← Back to HiddenTabby</a>
    <p class="eyebrow"><span class="section-index">SUPPORT</span> Built in the open</p>
    <h1>Support <em>HiddenTabby</em></h1>
    <p class="document-lede">HiddenTabby is open-source software, supported by volunteers and free for everyone to use.</p>

    <div class="document-content">
      <h2>Need help?</h2>
      <p>For help, feedback, or bug reports, open an issue in the <a href="https://github.com/cleaver/hiddentabby/issues">GitHub issue tracker</a>.</p>
      <h2>Explore the project</h2>
      <p>Read the source and follow development in the <a href="https://github.com/cleaver/hiddentabby">HiddenTabby GitHub repository</a>.</p>
    </div>
  </main>
</SiteLayout>
