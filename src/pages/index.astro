---
import FeatureShowcase from "../components/FeatureShowcase.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
// Homepage entry point for the static site build.
---

<SiteLayout isHome>
  <main id="main">
    <section class="hero container" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true">✳</span> A calmer way to keep tabs</p>
        <h1>Room for every part of your <em>day.</em></h1>
        <p class="hero-description">Give work, research, and everything else their own browser workspaces. Switch when your focus does.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#how-it-works">See how it works <span aria-hidden="true">↘</span></a>
          <span class="store-note">Chrome Web Store listing coming soon</span>
        </div>
        <div class="hero-meta">
          <span class="meta-item"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 8V6.2a4.5 4.5 0 0 1 9 0V8m-10.2 0h11.4v9H4.3z" /></svg>Saved in this browser profile</span>
          <span class="meta-divider" aria-hidden="true"></span>
          <span>Chrome &amp; Brave</span>
        </div>
      </div>

      <div class="hero-visual" aria-label="Illustrative HiddenTabby workspace preview">
        <div class="visual-sun" aria-hidden="true"></div>
        <div class="leaf-shape leaf-shape-one" aria-hidden="true"></div>
        <div class="leaf-shape leaf-shape-two" aria-hidden="true"></div>
        <div class="preview-window">
          <div class="preview-topbar" aria-hidden="true">
            <span></span><span></span><span></span>
            <div class="browser-tab"><img src="/assets/hiddentabby-logo.png" alt="" /> HiddenTabby</div>
            <span class="tab-plus">+</span>
          </div>
          <div class="preview-body">
            <div class="preview-heading">
              <img src="/assets/hiddentabby-logo.png" alt="" />
              <div><span class="preview-kicker">YOUR WORKSPACES</span><strong>Workspace Manager</strong></div>
              <span class="preview-menu" aria-hidden="true">•••</span>
            </div>
            <div class="preview-workspaces">
              <div class="workspace-row workspace-row-active">
                <span class="workspace-color color-green" aria-hidden="true"></span>
                <div class="workspace-content"><strong>Work</strong><span>Docs · Inbox · Notes</span></div>
                <span class="open-chip">Open</span>
              </div>
              <div class="workspace-row">
                <span class="workspace-color color-orange" aria-hidden="true"></span>
                <div class="workspace-content"><strong>Research</strong><span>Articles · References</span></div>
                <span class="open-chip">Open</span>
              </div>
              <div class="workspace-row">
                <span class="workspace-color color-lilac" aria-hidden="true"></span>
                <div class="workspace-content"><strong>For later</strong><span>Things to come back to</span></div>
                <span class="open-chip">Open</span>
              </div>
            </div>
            <div class="preview-footer"><span><i aria-hidden="true"></i>Example workspace names</span><span>Illustrative preview</span></div>
          </div>
        </div>
        <div class="floating-note"><span class="floating-note-icon" aria-hidden="true">↗</span><span>One click to switch<br /><strong>Pick up where you left off</strong></span></div>
        <div class="visual-caption"><span>MADE FOR THE WAY YOU BROWSE</span><span>01 / 03</span></div>
      </div>
    </section>

    <section class="benefit-strip" aria-label="HiddenTabby at a glance">
      <div class="container benefit-grid">
        <div class="benefit-item"><span class="benefit-number">01</span><div><strong>Named workspaces</strong><span>Give tabs a place to belong.</span></div></div>
        <div class="benefit-item"><span class="benefit-number">02</span><div><strong>Switch in a click</strong><span>Move between groups across windows.</span></div></div>
        <div class="benefit-item"><span class="benefit-number">03</span><div><strong>Kept local</strong><span>Your workspace data stays in your profile.</span></div></div>
      </div>
    </section>

    <section class="how-section section-space" id="how-it-works">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow"><span class="section-index">01</span> A little order, one click away</p>
          <h2>Keep the browser.<br /><em>Change the context.</em></h2>
          <p>HiddenTabby gives your open tabs a few good homes, then helps you move between them.</p>
        </div>

        <FeatureShowcase id="workspace-features" />
      </div>
    </section>

    <section class="privacy-section" id="privacy">
      <div class="container privacy-layout">
        <div class="privacy-heading">
          <p class="eyebrow"><span class="section-index">02</span> Your tabs stay yours</p>
          <h2>Private by <em>design.</em></h2>
          <p>HiddenTabby stores workspace information in your current browser profile. It does not sync or upload that data to an external service.</p>
          <a class="text-link" href="/privacy">Read the full privacy policy <span aria-hidden="true">↗</span></a>
        </div>
        <div class="privacy-points">
          <article class="privacy-point"><span class="privacy-icon" aria-hidden="true">⌂</span><div><h3>Stored locally</h3><p>Workspace names, tab titles, and URLs stay in browser storage on this profile.</p></div></article>
          <article class="privacy-point"><span class="privacy-icon" aria-hidden="true">◌</span><div><h3>No page contents</h3><p>HiddenTabby does not read page contents, form entries, or cookies. Pinned and incognito tabs are excluded.</p></div></article>
          <article class="privacy-point"><span class="privacy-icon" aria-hidden="true">↻</span><div><h3>Restore with care</h3><p>Saved tabs can be reopened when you switch groups. Unsaved page state may not return.</p></div></article>
        </div>
      </div>
    </section>

    <section class="closing-cta" id="get-hidden-tabby">
      <div class="container closing-card">
        <img src="/assets/hiddentabby-logo.png" alt="" class="closing-mascot" />
        <div><p class="eyebrow">A tidy little tab helper</p><h2>Make room for what’s next.</h2><p>The Chrome Web Store listing is on its way.</p></div>
        <span class="button button-coming" aria-label="Chrome Web Store listing coming soon">Coming soon <span aria-hidden="true">↗</span></span>
      </div>
    </section>
  </main>
</SiteLayout>
