---
import "../styles/global.css";

const {
  title = "HiddenTabby — room for every part of your day",
  description = "HiddenTabby keeps your browser tabs in named workspaces. Switch between projects in a click, with workspace data stored locally in your browser profile.",
  isHome = false,
} = Astro.props;

const sectionHref = (section) => (isHome ? `#${section}` : `/#${section}`);
const homeHref = isHome ? "#top" : "/#top";
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ea" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/hiddentabby-logo.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={homeHref} aria-label="HiddenTabby home">
          <img src="/assets/hiddentabby-logo.png" alt="" />
          <span>HiddenTabby</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={sectionHref("how-it-works")}>How it works</a>
          <a href={sectionHref("privacy")}>Privacy</a>
        </nav>
        <span class="store-status"><span class="status-dot" aria-hidden="true"></span>Chrome Web Store <span>coming soon</span></span>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand footer-brand" href={homeHref}>
          <img src="/assets/hiddentabby-logo.png" alt="" />
          <span>HiddenTabby</span>
        </a>
        <p>Small workspaces for a less tangled browser.</p>
        <div class="footer-links">
          <a href={isHome ? "/privacy" : "/#privacy"}>
            {isHome ? "Privacy policy" : "Back to privacy summary"}
          </a>
          <a href="mailto:meow@hiddentabby.com">Contact</a>
          <a class="github-badge" href="https://github.com/cleaver/hiddentabby" aria-label="HiddenTabby open-source project on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.94.58.11.79-.25.79-.56v-2.02c-3.2.7-3.88-1.36-3.88-1.36-.53-1.33-1.3-1.69-1.3-1.69-1.06-.72.08-.7.08-.7 1.18.08 1.8 1.21 1.8 1.21 1.04 1.78 2.73 1.27 3.4.97.11-.75.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.28 1.2-3.08-.12-.29-.52-1.46.11-3.04 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 5.82 0c2.22-1.5 3.2-1.18 3.2-1.18.63 1.58.23 2.75.11 3.04.75.8 1.2 1.82 1.2 3.08 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
            <span>Open source</span>
          </a>
          <a href="/support">Support</a>
          <span>Built for Chrome &amp; Brave</span>
        </div>
        <span class="copyright">© {currentYear} HiddenTabby</span>
      </div>
    </footer>
  </body>
</html>
